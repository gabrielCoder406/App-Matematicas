# Copia este archivo como .env para el modo desarrollo (npm run dev / npm start).
# En la app de escritorio no hace falta: todo se configura en Ajustes.

# IA local (Ollama): dirección del servidor de Ollama si no está en este mismo PC.
# OLLAMA_HOST_URL=http://127.0.0.1:11434

# Clave de la API de Claude: solo si eliges Claude (en vez de DeepSeek local) para leer la escritura.
# También se puede guardar desde Ajustes; la de Ajustes tiene prioridad.
ANTHROPIC_API_KEY=

# Modelo usado para el OCR (por defecto claude-opus-5-5).
# OCR_MODEL=claude-opus-5-5

# Nivel de esfuerzo del modelo para el OCR: low | medium | high (por defecto low, prioriza la velocidad).
# OCR_EFFORT=low

# Puerto del servidor local (API + WebSocket de emparejamiento). Vite lo usa como destino del proxy.
# API_PORT=8787
